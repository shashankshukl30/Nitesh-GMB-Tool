# ============================================================================
# Connect2Click — environment
#
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit a real key.
# ============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Google Places API (New) key, from the OWNER'S OWN Google Cloud project.
# Creating it, restricting it and capping it is step 2 of RUNBOOK.md.
# This is the only credential the application has.
GOOGLE_PLACES_API_KEY=

# ── RECOMMENDED ─────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Drives canonical URL, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://connect2click.com

# ── OPTIONAL ────────────────────────────────────────────────────────────────
# Where the report's closing call-to-action points. A WhatsApp link
# (https://wa.me/919999999999), a mailto:, or a booking page.
# LEAVE BLANK and the button is hidden rather than rendering a dead link.
NEXT_PUBLIC_CONTACT_URL=

# One-line pitch under that CTA. Has a sensible default; override to taste.
NEXT_PUBLIC_CONTACT_PITCH=

# Label on the CTA button. Defaults to "Talk to us about fixing this →".
NEXT_PUBLIC_CONTACT_CTA=

# Courtesy brake on daily Places calls per running instance (default 2000).
# This is NOT the real cost ceiling — the enforceable cap is the daily quota
# set in Google Cloud Console. See RUNBOOK.md step 2c.
PLACES_DAILY_CAP=

# Set to 1 to stop all Google calls dead — an instant kill switch that needs
# no code change and no key rotation. Redeploy or change the env var to undo.
PLACES_DISABLED=
